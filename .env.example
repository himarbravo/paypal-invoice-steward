# Copy to .env and fill in what you need. Leave everything empty to run in demo
# mode: a built-in fake PayPal with sample data, no accounts needed.
# .env is ignored by Git: never commit real credentials.

# PayPal SANDBOX app credentials (developer.paypal.com > Apps & Credentials > Sandbox).
# Setting both switches the app to sandbox mode. The client refuses non-sandbox URLs.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# STEWARD_MODE=demo            # force demo or sandbox
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional: lets Claude understand free-form requests.
# Without it, a simple offline assistant handles the suggested prompts.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional policy limits, enforced by the server
# STEWARD_MAX_INVOICE=10000
# STEWARD_REMINDER_COOLDOWN_DAYS=3

# Optional runtime settings
# STEWARD_DB=data/steward.db
# HOST=127.0.0.1
# PORT=8000
